<button type="submit" form="@Formulario" class="boton boton-primario" disabled="@Ocupado">
    @if (Ocupado) { <Icono Nombre="cargando" Clase="girar" /> } @Texto
</button>
@code {
    [Parameter, EditorRequired] public string Formulario { get; set; } = "";
    [Parameter] public bool Ocupado { get; set; }
    [Parameter] public string Texto { get; set; } = "Guardar";
}
